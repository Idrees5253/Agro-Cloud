# Copy this file to .env and fill in your key. Never commit the real .env file.
# Get a free key at https://openrouter.ai/keys (sign up, no card required for free-tier models)
OPENROUTER_API_KEY=

# Optional — override the auto-router with a specific model id.
# Default (when left blank) is 'openrouter/free', which auto-picks a currently-live
# free model on every request — the safest choice since free-tier model
# availability on OpenRouter rotates over time. Only set this if you want a fixed model:
# check https://openrouter.ai/models?max_price=0 for current options.
OPENROUTER_MODEL=
